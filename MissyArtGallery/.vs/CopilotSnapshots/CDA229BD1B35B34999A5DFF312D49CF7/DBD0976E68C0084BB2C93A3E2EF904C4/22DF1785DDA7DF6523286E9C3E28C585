/* Clean gallery header styles */
.gallery-header-clean {
  position: relative;
  z-index: 2;
  background: transparent;
  padding: 2rem 0 1rem 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gallery-header-clean .site-title {
  font-size: 3rem;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: #111;
  margin-bottom: 1.5rem;
  text-align: center;
  user-select: none;
}
.gallery-nav-clean {
  display: flex;
  gap: 2.5rem;
  justify-content: center;
  margin-bottom: 1.5rem;
}
.gallery-nav-clean .nav-link {
  font-size: 2rem;
  font-weight: bold;
  color: #111;
  text-decoration: none;
  background: none;
  border: none;
  padding: 0.5rem 1rem;
  transition: color 0.3s;
  cursor: pointer;
  user-select: none;
}
.gallery-nav-clean .nav-link:hover, .gallery-nav-clean .nav-link:focus {
  color: #e6007a;
}
.site-subtitle { 
  font-size: 1.1rem;
  margin-top: 0.5rem;
  margin-bottom: 2rem;
  color: #111;
  text-align: center;
  letter-spacing: 0.05em;
  user-select: none;
}
/* Colorful, modern, mobile-first styles for the digital art gallery */
body {
  margin: 0;
  font-family: 'Segoe UI', Arial, sans-serif;
  color: #111;
}

.home-bg {
  min-height: 100vh;
  width: 100vw;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  overflow: hidden;
}
.home-bg::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: url('homeback16x9.jpg') center center/cover no-repeat;
  filter: grayscale(1);
  z-index: 0;
  pointer-events: none;
}
.home-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  z-index: 2;
}
.home-overlay-top {
  padding-top: 5vh;
}
.site-title {
  font-size: 3rem;
  font-weight: bold;
  letter-spacing: 0.1em;
  color: #111;
  margin-bottom: 2rem;
  text-align: center;
  user-select: none;
}
.home-nav {
  display: flex;
  gap: 2.5rem;
  margin-top: 1rem;
}
.nav-link {
  font-size: 2rem;
  font-weight: bold;
  color: #111;
  text-decoration: none;
  background: none;
  border: none;
  padding: 0.5rem 1rem;
  transition: color 0.3s;
  cursor: pointer;
  user-select: none;
}
.nav-link:hover, .nav-link:focus {
  color: #e6007a;
}
.nav-link.active,
.nav-link.visited {
  color: #00e6e6;
  filter: none !important;
}

/* Gallery page background */



  /* Add body-specific styles here if needed */

.gallery-bg {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  background: url('Gallery/gallery-backgroundbw.png') repeat;
  background-size: 600px auto;
  pointer-events: none;
}
/* Remove ::before, use direct background on .gallery-bg for reliability */
.gallery-header {
  position: relative;
  z-index: 2;
  background: transparent;
  padding: 2rem 0 1rem 0;
  text-align: center;
}
.gallery-title {
  font-size: 2rem;
  font-weight: bold;
  color: #111;
  margin-bottom: 0.5rem;
}
.gallery-nav {
  display: flex;
  gap: 2rem;
  justify-content: center;
  margin-bottom: 1.5rem;
}
.gallery-nav .nav-link {
  font-size: 1.2rem;
}
/* ...existing gallery grid and thumb styles... */

.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #e6007a;
  padding: 1rem 2rem;
  position: sticky;
  top: 0;
  z-index: 100;
}
.gallery-title {
  font-size: 1.5rem;
  font-weight: bold;
  letter-spacing: 2px;
}
.nav-links a {
  color: #fff;
  text-decoration: none;
  margin-left: 2rem;
  font-weight: 500;
  transition: color 0.2s;
}
.nav-links a:hover {
  color: #ffb300;
}
.hero {
  text-align: center;
  padding: 4rem 1rem 2rem 1rem;
  background: linear-gradient(120deg, #e6007a 0%, #00e6e6 100%);
}
.hero h1 {
  font-size: 2.5rem;
  margin: 0 0 1rem 0;
  color: #fff;
  letter-spacing: 3px;
}
.hero-sub {
  font-size: 1.2rem;
  color: #fff;
  opacity: 0.8;
}
.about-section {
  background: #231942;
  padding: 2rem 0 3rem 0;
  overflow-x: hidden;
}
.about-section h2 {
  text-align: center;
  margin-bottom: 2rem;
  color: #ffb300;
}
.about-panels {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  gap: 2rem;
  padding: 0 2rem;
  justify-content: center;
}
.about-panel {
  flex: 0 0 70vw;
  max-width: 400px;
  min-width: 280px;
  background: #2d1457;
  border-radius: 1.5rem;
  box-shadow: 0 4px 24px #0008;
  margin-bottom: 1rem;
  scroll-snap-align: center;
  filter: grayscale(1);
  transition: filter 0.4s, box-shadow 0.3s;
  position: relative;
  text-align: center;
}
.about-panel.active {
  filter: grayscale(0);
  box-shadow: 0 8px 32px #e6007a88;
}
.about-panel img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 1.5rem 1.5rem 0 0;
}
.bio {
  padding: 1rem;
  color: #fff;
  font-size: 1rem;
}
.gallery-section {
  background: transparent;
  padding: 2rem 0 4rem 0;
}
.gallery-section h2 {
  text-align: center;
  color: #00e6e6;
  margin-bottom: 2rem;
}
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 1.5rem;
  padding: 0 2rem;
}
.gallery-thumb {
  width: 100%;
  aspect-ratio: 1/1;
  object-fit: cover;
  border-radius: 1rem;
  filter: grayscale(1);
  transition: filter 0.4s, box-shadow 0.3s;
  cursor: pointer;
  box-shadow: 0 2px 12px #0006;
  background: #222;
}
.gallery-thumb.visited {
  filter: grayscale(0) !important;
}
.gallery-thumb:hover,
.gallery-thumb:focus {
  filter: grayscale(0);
  box-shadow: 0 4px 24px #00e6e688;
}
#backToTop {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  background: #e6007a;
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  font-size: 2rem;
  cursor: pointer;
  box-shadow: 0 2px 12px #0008;
  opacity: 0.7;
  z-index: 200;
  transition: opacity 0.2s, background 0.2s;
}
#backToTop:hover {
  opacity: 1;
  background: #ffb300;
  color: #231942;
}
.modal {
  display: none;
  position: fixed;
  z-index: 300;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  overflow: auto;
  background: url('Gallery/gallery-backgroundbw.png') repeat;
  background-size: 600px auto;
  /* No grayscale filter for new image */
  align-items: center;
  justify-content: center;
}
.modal-content {
    display: block;
    margin: 5vh auto;
    width: 100vw;
    max-width: 400px;
    height: auto;
    object-fit: contain;
    border-radius: 1rem;
    box-shadow: 0 8px 32px #e6007a88;
    background: #fff;
}
 /* ...existing styles... */
 /* ...your media queries below... */

  @media (max-width: 400px) {
    .modal-content {
      max-width: 100vw;
      border-radius: 0;
    }
  }
@media (max-width: 700px) {
  .modal-content {
    max-width: 100vw;
    width: 100vw;
    border-radius: 0;
  }
}
.close {
  position: absolute;
  top: 2rem;
  right: 3rem;
  color: #111;
  font-size: 2.5rem;
  font-weight: bold;
  cursor: pointer;
  z-index: 400;
  transition: color 0.2s;
}
.close:hover {
  color: #ffb300;
}
@media (max-width: 600px) {
  .about-panel {
    flex: 0 0 90vw;
    max-width: 95vw;
  }
  .about-panels {
    gap: 1rem;
    padding: 0 0.5rem;
  }
  .gallery-grid {
    gap: 0.7rem;
    padding: 0 0.5rem;
  }
  #backToTop {
    width: 40px;
    height: 40px;
    font-size: 1.5rem;
    bottom: 1rem;
    right: 1rem;
  }
}
.color-wave {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
  mix-blend-mode: color;
  background: linear-gradient(
    90deg,
    transparent 0%,
    transparent 45%,
    #fff 50%,
    transparent 55%,
    transparent 100%
  );
  opacity: 0.7;
  transition: background-position 0.5s;
}