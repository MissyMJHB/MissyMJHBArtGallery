<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Digital Art Gallery</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
    <div class="home-bg">
        <div class="home-overlay home-overlay-top">
            <h1 class="site-title" id="animatedTitle">Missy Art Gallery</h1>
            <div class="site-subtitle" id="animatedSubtitle">Make your day brighter</div>
            <nav class="home-nav">
                <a href="gallery.html" class="nav-link" id="galleryLink">Gallery</a>
                <a href="#" class="nav-link" id="aboutLink">About the Artist</a>
                <a href="#" class="nav-link" id="contactLink">Contact the Artist</a>
            </nav>
        </div>
    </div>
    <div class="color-wave"></div>
  
  <script src="home-anim.js"></script>
  <script>
    // Home navigation link handlers
    document.addEventListener('DOMContentLoaded', function () {
      const navLinks = document.querySelectorAll('.nav-link');
      // Restore active link from localStorage
      const savedActive = localStorage.getItem('activeNavLink');
      if (savedActive) {
        const savedLink = document.getElementById(savedActive);
        if (savedLink) savedLink.classList.add('active');
      }
      navLinks.forEach(link => {
        link.addEventListener('click', function(e) {
          navLinks.forEach(l => l.classList.remove('active'));
          this.classList.add('active');
          localStorage.setItem('activeNavLink', this.id);
        });
      });
      document.getElementById('galleryLink').onclick = function(e) {
        e.preventDefault();
        this.classList.add('active');
        window.location.href = 'gallery.html';
      };
      document.getElementById('aboutLink').onclick = function(e) {
        e.preventDefault();
        this.classList.add('active');
        window.openAboutMe && window.openAboutMe();
      };
      document.getElementById('contactLink').onclick = function(e) {
        e.preventDefault();
        this.classList.add('active');
        alert('Contact the Artist coming soon!');
      };
    });
  </script>
  <!-- Modal for full image view (shared with gallery) -->
  <div class="modal" id="imageModal">
    <span class="close">&times;</span>
    <img class="modal-content" id="modalImg" />
  </div>
  <script src="gallery.js"></script>
</body>
</html>
